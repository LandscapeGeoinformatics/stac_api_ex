  "type" => "Catalog",
  "stac_version" => "1.0.0",
  "parent_catalog_id" => "my-test-catalog"
}

{:ok, response} = Req.post(manage_req, url: "/catalogs", json: nested_catalog_data)

IO.puts("Status: #{response.status}")
response.body
