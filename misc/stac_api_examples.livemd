```elixir
# Use the key helpers: issue, rotate, find unused keys, delete
{:ok, secret, key} =
  STACKeys.create(manage_req, "Helper demo #{suffix}",
    role: "read_only",
    expires_at: DateTime.add(DateTime.utc_now(), 30 * 86_400, :second),
    note: "Created by STACKeys.create/3"
  )

IO.puts("Issued #{key["name"]} (#{mask.(secret)}), expires #{key["expires_at"]}")

{:ok, new_secret, _key} = STACKeys.rotate(manage_req, key["id"])
IO.puts("Rotated, new secret #{mask.(new_secret)}")

{:error, details} = STACKeys.update(manage_req, key["id"], %{"role" => "read_write"})
IO.puts("Role change refused: #{inspect(details)}")

{:ok, unused} = STACKeys.unused(manage_req)
IO.puts("Keys unused for 90 days: #{Enum.map_join(unused, ", ", & &1["name"])}")

STACKeys.delete(manage_req, key["id"])
```

