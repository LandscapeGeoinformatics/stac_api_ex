## Helper Functions

Reusable helpers. Pass `manage_req` (authenticated, manage base URL) for catalog and key
operations, and `req` (public STAC API base URL) for browsing collections and items.

```elixir
defmodule STACHelpers do
  @doc "List all catalogs. Pass manage_req (auth required)."
  def list_catalogs(manage_req) do
    case Req.get(manage_req, url: "/catalogs") do
      {:ok, %{status: 200, body: body}} -> {:ok, body["catalogs"]}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Get a specific catalog. Pass manage_req (auth required)."
  def get_catalog(manage_req, id) do
    case Req.get(manage_req, url: "/catalogs/#{id}") do
      {:ok, %{status: 200, body: body}} -> {:ok, body}
      {:ok, %{status: 404}} -> {:error, :not_found}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Create a catalog. Pass manage_req (RW key required)."
  def create_catalog(manage_req, catalog_data) do
    case Req.post(manage_req, url: "/catalogs", json: catalog_data) do
      {:ok, %{status: 201, body: body}} -> {:ok, body["data"]}
      {:ok, %{status: 409}} -> {:error, :already_exists}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Full replacement of a catalog. Pass manage_req (RW key required)."
  def update_catalog(manage_req, id, catalog_data) do
    case Req.put(manage_req, url: "/catalogs/#{id}", json: catalog_data) do
      {:ok, %{status: 200, body: body}} -> {:ok, body["data"]}
      {:ok, %{status: 404}} -> {:error, :not_found}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Delete a catalog (cascade). Pass manage_req (RW key required)."
  def delete_catalog(manage_req, id) do
    case Req.delete(manage_req, url: "/catalogs/#{id}") do
      {:ok, %{status: 200, body: body}} -> {:ok, body["cascade_deleted"]}
      {:ok, %{status: 404}} -> {:error, :not_found}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, STACHelpers,
 <<70, 79, 82, 49, 0, 0, 17, 120, 66, 69, 65, 77, 65, 116, 85, 56, 0, 0, 1, 107, 0, 0, 0,
   38, 18, 69, 108, 105, 120, 105, 114, 46, 83, 84, 65, 67, 72, 101, 108, 112, 101, 114,
   115, 8, 95, 95, 105, ...>>, {:delete_catalog, 2}}
```

```elixir
defmodule STACKeys do
  @moduledoc """
  Personal API key management. Every function needs a client with the static
  STAC_API_KEY (manage_req); issued keys get 401 on these endpoints.
  """

  @doc "List keys (never includes secrets)."
  def list(manage_req) do
    case Req.get(manage_req, url: "/api-keys") do
      {:ok, %{status: 200, body: body}} -> {:ok, body["data"]}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc """
  Issue a key. `opts`: `:role` ("read_only" default, or "read_write"),
  `:expires_at` (DateTime), `:contact`, `:note`. Returns `{:ok, secret, key}`;
  the secret is only available here.
  """
  def create(manage_req, name, opts \\ []) do
    body =
      %{
        "name" => name,
        "role" => opts[:role],
        "expires_at" => opts[:expires_at] && DateTime.to_iso8601(opts[:expires_at]),
        "contact" => opts[:contact],
        "note" => opts[:note]
      }
      |> Map.reject(fn {_, v} -> is_nil(v) end)

    case Req.post(manage_req, url: "/api-keys", json: body) do
      {:ok, %{status: 201, body: %{"data" => data}}} -> {:ok, data["key"], Map.delete(data, "key")}
      {:ok, %{status: 422, body: body}} -> {:error, body["details"]}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Change name, expires_at, contact or note. Only the given fields change; nil clears."
  def update(manage_req, id, changes) do
    case Req.patch(manage_req, url: "/api-keys/#{id}", json: changes) do
      {:ok, %{status: 200, body: body}} -> {:ok, body["data"]}
      {:ok, %{status: 404}} -> {:error, :not_found}
      {:ok, %{status: 422, body: body}} -> {:error, body["details"]}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "New secret for the same key; the old one stops working. Returns `{:ok, secret, key}`."
  def rotate(manage_req, id) do
    case Req.post(manage_req, url: "/api-keys/#{id}/rotate") do
      {:ok, %{status: 200, body: %{"data" => data}}} -> {:ok, data["key"], Map.delete(data, "key")}
      {:ok, %{status: 404}} -> {:error, :not_found}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Delete a key; it stops working immediately."
  def delete(manage_req, id) do
    case Req.delete(manage_req, url: "/api-keys/#{id}") do
      {:ok, %{status: 200}} -> :ok
      {:ok, %{status: 404}} -> {:error, :not_found}
      {:ok, response} -> {:error, response}
      error -> error
    end
  end

  @doc "Keys that were never used, or not in the last `days` days."
  def unused(manage_req, days \\ 90) do
    cutoff = DateTime.add(DateTime.utc_now(), -days * 86_400, :second)

    with {:ok, keys} <- list(manage_req) do
      {:ok,
       Enum.filter(keys, fn key ->
         case key["last_used_at"] && DateTime.from_iso8601(key["last_used_at"]) do
           {:ok, used, _} -> DateTime.compare(used, cutoff) == :lt
           _ -> true
         end
       end)}
    end
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, STACKeys,
 <<70, 79, 82, 49, 0, 0, 28, 36, 66, 69, 65, 77, 65, 116, 85, 56, 0, 0, 2, 13, 0, 0, 0,
   63, 15, 69, 108, 105, 120, 105, 114, 46, 83, 84, 65, 67, 75, 101, 121, 115, 8, 95, 95,
   105, 110, 102, 111, ...>>, {:unused, 2}}
```

```elixir
# Use the catalog helpers
{:ok, catalogs} = STACHelpers.list_catalogs(manage_req)
IO.puts("Found #{length(catalogs)} catalogs")

new_catalog = %{
  "id" => "helper-test-#{:rand.uniform(10000)}",
  "title" => "Created via Helper",
  "description" => "Test catalog"
}

case STACHelpers.create_catalog(manage_req, new_catalog) do
  {:ok, catalog} ->
    IO.puts("Created: #{catalog["id"]}")
    {:ok, cascade} = STACHelpers.delete_catalog(manage_req, catalog["id"])
    IO.puts("Deleted again: #{inspect(cascade)}")

  {:error, reason} ->
    IO.puts("Error: #{inspect(reason)}")
end
```

