### Use the read-only key

On the public STAC API the key unlocks the private catalog. It cannot write.

```elixir
{:ok, anonymous} = Req.get(req, url: "/collections/#{demo_collection}")
{:ok, with_ro_key} = Req.get(stac_client.(ro_key), url: "/collections/#{demo_collection}")

{:ok, search} =
  Req.get(stac_client.(ro_key), url: "/search", params: [collections: demo_collection])

{:ok, write_attempt} =
  Req.patch(manage_client.(ro_key),
    url: "/collections/#{demo_collection}",
    json: %{"title" => "Renamed with a read-only key"}
  )

%{
  "anonymous GET collection" => anonymous.status,
  "read-only key GET collection" => with_ro_key.status,
  "read-only key search, items found" => search.body["numberMatched"],
  "read-only key PATCH collection" => {write_attempt.status, write_attempt.body["message"]}
}
```

<!-- livebook:{"output":true} -->

```
%{
  "anonymous GET collection" => 404,
  "read-only key GET collection" => 200,
  "read-only key PATCH collection" => {401,
   "Invalid API key. Write operations require read-write (RW) key"},
  "read-only key search, items found" => 1
}
```

### Use the read-write key

An issued read-write key works for catalogs, collections, items and bulk import, but it can
never manage keys, so it cannot mint more keys for itself.

```elixir
rw = manage_client.(rw_key)

{:ok, created} =
  Req.post(rw,
    url: "/items",
    json: %{
      "id" => "keys-demo-upload-#{suffix}",
      "collection_id" => demo_collection,
      "geometry" => %{"type" => "Point", "coordinates" => [24.75, 59.44]},
      "bbox" => [24.75, 59.44, 24.75, 59.44],
      "properties" => %{"datetime" => "2024-06-01T09:00:00Z"}
    }
  )

{:ok, patched} =
  Req.patch(rw,
    url: "/collections/#{demo_collection}",
    json: %{"title" => "Renamed with an issued read-write key"}
  )

{:ok, deleted} = Req.delete(rw, url: "/items/keys-demo-upload-#{suffix}")
{:ok, list_keys} = Req.get(rw, url: "/api-keys")
{:ok, mint_key} = Req.post(rw, url: "/api-keys", json: %{"name" => "sneaky #{suffix}"})

%{
  "POST item" => created.status,
  "PATCH collection" => {patched.status, patched.body["data"]["title"]},
  "DELETE item" => deleted.status,
  "GET /api-keys" => {list_keys.status, list_keys.body["message"]},
  "POST /api-keys" => mint_key.status
}
```

<!-- livebook:{"output":true} -->

```
%{
  "DELETE item" => 200,
  "GET /api-keys" => {401,
   "Invalid API key. Key management requires the static read-write key"},
  "PATCH collection" => {200, "Renamed with an issued read-write key"},
  "POST /api-keys" => 401,
  "POST item" => 201
}
```

