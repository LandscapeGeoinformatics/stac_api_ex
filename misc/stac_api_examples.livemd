  {"conformance", "https://metadata.geokuup.ee/stac/api/v1/conformance"},
  {"service-desc", "https://metadata.geokuup.ee/stac/api/v1/openapi.json"},
  {"service-doc", "https://metadata.geokuup.ee/stac/api/v1/docs"},
  {"data", "https://metadata.geokuup.ee/stac/api/v1/collections"},
  {"search", "https://metadata.geokuup.ee/stac/api/v1/search"},
  {"search", "https://metadata.geokuup.ee/stac/api/v1/search"},
  {"browser", "https://metadata.geokuup.ee/stac/web/browse"},
  {"child", "https://metadata.geokuup.ee/stac/api/v1/catalog/geokuup"}
]
```

