# All catalogs (management endpoint, RW key)
{:ok, response} = Req.get(manage_req, url: "/catalogs")

IO.puts("Status: #{response.status}")

Enum.map(response.body["catalogs"], &Map.take(&1, ["id", "title"]))
```

