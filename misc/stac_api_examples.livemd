### Edit a key (PATCH)

`PATCH` changes `name`, `expires_at`, `contact` and `note`. Fields that are not sent stay
as they are, and `null` clears a field (`"expires_at": null` removes the expiry). The secret
does not change.

```elixir
{:ok, response} =
  Req.patch(manage_req,
    url: "/api-keys/#{rw_key_id}",
    json: %{
      "name" => "Upload script, thesis #{suffix}",
      "expires_at" => end_of_semester |> DateTime.add(30 * 86_400, :second) |> DateTime.to_iso8601(),
      "contact" => nil
    }
  )

IO.puts("Status: #{response.status}")
response.body["data"] |> Map.take(["name", "role", "expires_at", "contact", "note", "updated_at"])
```

<!-- livebook:{"output":true} -->

```
Status: 200
```

<!-- livebook:{"output":true} -->

```
%{
  "contact" => nil,
  "expires_at" => "2027-03-16T15:45:03.000000Z",
  "name" => "Upload script, thesis 6594",
  "note" => "Nightly item upload, until the end of the semester",
  "role" => "read_write",
  "updated_at" => "2026-11-16T15:45:03.178591Z"
}
```

What `PATCH` refuses, with `422` and a `details` map:

```elixir
patch_key = fn body ->
  {:ok, response} = Req.patch(manage_req, url: "/api-keys/#{rw_key_id}", json: body)
  {response.status, response.body["details"]}
end

%{
  "role (fixed at creation)" => patch_key.(%{"role" => "read_only"}),
  "expires_at in the past" => patch_key.(%{"expires_at" => "2020-01-01T00:00:00Z"}),
  "empty name" => patch_key.(%{"name" => ""}),
  "name of another key" => patch_key.(%{"name" => "Anna - field data #{suffix}"})
}
```

<!-- livebook:{"output":true} -->

```
%{
  "empty name" => {422, %{"name" => ["can't be blank"]}},
  "expires_at in the past" => {422, %{"expires_at" => ["must be in the future"]}},
  "name of another key" => {422, %{"name" => ["has already been taken"]}},
  "role (fixed at creation)" => {422,
   %{
     "role" => ["cannot be changed; issue a new key with the role you need and delete this one"]
   }}
}
```

```elixir
# An empty PATCH is a no-op: nothing changes, not even updated_at
{:ok, before} = Req.get(manage_req, url: "/api-keys/#{rw_key_id}")
{:ok, response} = Req.patch(manage_req, url: "/api-keys/#{rw_key_id}", json: %{})

IO.puts("Status: #{response.status}")
IO.puts("updated_at unchanged: #{before.body["data"]["updated_at"] == response.body["data"]["updated_at"]}")
```

<!-- livebook:{"output":true} -->

```
Status: 200
updated_at unchanged: true
```

<!-- livebook:{"output":true} -->

```
:ok
```

### Rotate a key

Rotation issues a new secret for the same key (same id, name, role and `expires_at`). The
old secret stops working immediately. Use it when a key may have leaked, or when someone
lost theirs.

```elixir
{:ok, response} = Req.post(manage_req, url: "/api-keys/#{rw_key_id}/rotate")

IO.puts("Status: #{response.status}")
IO.puts(response.body["message"])

old_rw_key = rw_key
rw_key = response.body["data"]["key"]

{:ok, old_secret} = Req.get(manage_client.(old_rw_key), url: "/collections")
{:ok, new_secret} = Req.get(manage_client.(rw_key), url: "/collections")

%{
  "new key_prefix" => response.body["data"]["key_prefix"],
  "expires_at (never moved by rotate)" => response.body["data"]["expires_at"],
  "old secret" => old_secret.status,
  "new secret" => new_secret.status
}
```

<!-- livebook:{"output":true} -->

```
Status: 200
API key rotated successfully. Store the new key now; it cannot be shown again, and the old one no longer works.
```

<!-- livebook:{"output":true} -->

```
%{
  "expires_at (never moved by rotate)" => "2027-03-16T15:45:03.000000Z",
  "new key_prefix" => "stac_rw_qN1o",
  "new secret" => 200,
  "old secret" => 401
}
```

### Expiry

An expired key is invalid everywhere straight away. Rotating does not bring it back, since
`expires_at` is the admin's final date. To revive a key, `PATCH` a future `expires_at`.

```elixir
{:ok, response} =
  Req.post(manage_req,
    url: "/api-keys",
    json: %{
      "name" => "Short-lived #{suffix}",
      "role" => "read_write",
      "expires_at" => DateTime.utc_now() |> DateTime.add(3, :second) |> DateTime.to_iso8601()
    }
  )

short_key = response.body["data"]["key"]
short_key_id = response.body["data"]["id"]

check = fn key ->
  {:ok, public} = Req.get(stac_client.(key), url: "/collections/#{demo_collection}")
  {:ok, manage} = Req.get(manage_client.(key), url: "/collections")
  %{"private collection" => public.status, "management API" => manage.status}
end

valid = check.(short_key)
Process.sleep(4_000)
expired = check.(short_key)

{:ok, _} =
  Req.patch(manage_req,
    url: "/api-keys/#{short_key_id}",
    json: %{"expires_at" => DateTime.utc_now() |> DateTime.add(86_400, :second) |> DateTime.to_iso8601()}
  )

%{"valid" => valid, "expired" => expired, "after PATCH expires_at" => check.(short_key)}
```

<!-- livebook:{"output":true} -->

```
%{
  "after PATCH expires_at" => %{"management API" => 200, "private collection" => 200},
  "expired" => %{"management API" => 401, "private collection" => 404},
  "valid" => %{"management API" => 200, "private collection" => 200}
}
```

### Web browser

Personal keys also work in the web browser: open `/stac/web/browse`, click the lock icon
and paste the key. A read-only key shows private catalogs; a read-write key also shows the
Management API in the docs (`/stac/api/v1/docs`). An unlocked browser session stays unlocked
until it ends or the lock is used, even if its key expires or is deleted meanwhile.

```elixir
"#{base_url}/stac/web/browse"
```

<!-- livebook:{"output":true} -->

```
"http://localhost:4000/stac/web/browse"
```

### Delete keys

Deleting a key is permanent and takes effect immediately.

```elixir
deleted =
  for id <- [ro_key_id, rw_key_id, short_key_id] do
    {:ok, response} = Req.delete(manage_req, url: "/api-keys/#{id}")
    {id, response.status}
  end

{:ok, after_delete} = Req.get(stac_client.(ro_key), url: "/collections/#{demo_collection}")
IO.puts("Deleted read-only key on the private collection: #{after_delete.status}")

# Clean up the demo catalog (cascades to its collection and items)
{:ok, response} = Req.delete(manage_req, url: "/catalogs/#{demo_catalog}")
IO.puts("Demo catalog deleted: #{response.status} #{inspect(response.body["cascade_deleted"])}")

deleted
```

<!-- livebook:{"output":true} -->

```
Deleted read-only key on the private collection: 404
Demo catalog deleted: 200 %{"catalogs" => 0, "collections" => 1, "items" => 1}
```

<!-- livebook:{"output":true} -->

```
[{9, 200}, {10, 200}, {11, 200}]
```

## Complete Workflow Example

Here's a complete example showing the full lifecycle:

```elixir
# 1. Create a demo hierarchy
IO.puts("1. Creating demo catalog...")

demo_catalog = %{
  "id" => "demo-catalog-#{:rand.uniform(10000)}",
  "title" => "Demo Catalog",
  "description" => "Temporary demo catalog"
}

{:ok, catalog_response} = Req.post(manage_req, url: "/catalogs", json: demo_catalog)
catalog_id = catalog_response.body["data"]["id"]
IO.puts("   Created catalog: #{catalog_id}")

# 2. Create a collection under it
IO.puts("\n2. Creating demo collection...")

demo_collection = %{
  "id" => "demo-collection-#{:rand.uniform(10000)}",
  "title" => "Demo Collection",
  "description" => "Collection under demo catalog",
  "license" => "CC-BY-4.0",
  "catalog_id" => catalog_id,
  "extent" => %{
    "spatial" => %{"bbox" => [[-180, -90, 180, 90]]},
    "temporal" => %{"interval" => [["2024-01-01T00:00:00Z", nil]]}
  }
}

{:ok, collection_response} = Req.post(manage_req, url: "/collections", json: demo_collection)
collection_id = collection_response.body["data"]["id"]
IO.puts("   Created collection: #{collection_id}")

# 3. Verify resources exist
# Catalogs via manage (requires auth); collections via STAC API (public)
IO.puts("\n3. Verifying resources...")
{:ok, verify_response} = Req.get(manage_req, url: "/catalogs/#{catalog_id}")
IO.puts("   Catalog exists: #{verify_response.body["id"]}")

{:ok, collection_verify} = Req.get(req, url: "/collections/#{collection_id}")
IO.puts("   Collection exists: #{collection_verify.body["id"]}")

# 4. Update the catalog
IO.puts("\n4. Updating catalog title...")

{:ok, update_response} =
  Req.patch(manage_req,
    url: "/catalogs/#{catalog_id}",
    json: %{"id" => catalog_id, "title" => "Updated Demo Catalog"}
  )

IO.puts("   New title: #{update_response.body["data"]["title"]}")

# 5. Clean up - cascade delete everything
IO.puts("\n5. Cleaning up (cascade delete)...")
{:ok, delete_response} = Req.delete(manage_req, url: "/catalogs/#{catalog_id}")
IO.puts("   Deleted successfully!")
IO.puts("   Cascade summary: #{inspect(delete_response.body["cascade_deleted"])}")

# 6. Verify deletion
IO.puts("\n6. Verifying deletion...")

case Req.get(manage_req, url: "/catalogs/#{catalog_id}") do
  {:ok, %{status: 404}} -> IO.puts("   ✓ Catalog successfully deleted")
  {:ok, _} -> IO.puts("   ✗ Catalog still exists!")
end
```

<!-- livebook:{"output":true} -->

```
1. Creating demo catalog...
   Created catalog: demo-catalog-8314

2. Creating demo collection...
   Created collection: demo-collection-8500

3. Verifying resources...
   Catalog exists: demo-catalog-8314
   Collection exists: demo-collection-8500

4. Updating catalog title...
   New title: Updated Demo Catalog

5. Cleaning up (cascade delete)...
   Deleted successfully!
   Cascade summary: %{"catalogs" => 0, "collections" => 1, "items" => 0}

6. Verifying deletion...
   ✓ Catalog successfully deleted
```

<!-- livebook:{"output":true} -->

```
:ok
```

## Error Handling Examples

```elixir
# Create a catalog without authentication -> 401
# The Management API always requires a valid RW key
no_auth_req = Req.new(base_url: base_url <> manage_version)

case Req.post(no_auth_req, url: "/catalogs", json: %{"id" => "test"}) do
  {:ok, %{status: 401} = response} ->
    IO.puts("Expected 401 Unauthorized:")
    response.body

  other ->
    IO.puts("Unexpected response:")
    other
end
```

<!-- livebook:{"output":true} -->

```
Expected 401 Unauthorized:
```

