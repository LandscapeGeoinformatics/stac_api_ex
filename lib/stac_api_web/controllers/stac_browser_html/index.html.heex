<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-900">STAC Data Browser</h1>
      </div>
      
      <%!-- Right-side controls: keep Search Items exactly as-is, then add lock/unlock UI --%>
      <div class="inline-flex items-center space-x-2">
        <a 
          href="/stac/web/search" 
          class="btn btn-md bg-secondary hover:bg-secondary text-white hover:text-primary transition-transform duration-200 hover:scale-105 shadow-md shadow-black/50 border-black hover:border-black text-md font-bold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          Search Items
        </a>

        <%!-- Minimal auth controls placed next to Search Items --%>
<%!-- Auth controls component --%>
<.auth_controls browse_authenticated={@browse_authenticated} current_path={"/stac/web/browse/#{@current_path}"} />
      </div>
    </div>
  </div>

  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm">
      <%= for {breadcrumb, index} <- Enum.with_index(@breadcrumbs) do %>
        <%= if index > 0 do %>
          <li class="text-gray-400">/</li>
        <% end %>
        <li>
          <%= if index == length(@breadcrumbs) - 1 do %>
            <span class="text-gray-600 font-medium"><%= breadcrumb.name %></span>
          <% else %>
            <a href={"/stac/web/browse/#{breadcrumb.path}"} 
               class="text-blue-600 hover:text-blue-800 hover:underline">
              <%= breadcrumb.name %>
            </a>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <%= if @current_type == :catalog && @current_entity do %>
    <div class="mb-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
      <div class="flex items-start justify-between">
        <h2 class="text-lg font-semibold text-blue-900 mb-2"><%= @current_entity.title || @current_entity.id %></h2>

      </div>
      <%= if @current_entity.description do %>
        <p class="text-sm text-blue-700"><%= @current_entity.description %></p>
      <% end %>
    </div>
  <% end %>

  <%= if @current_type == :collection && @current_entity do %>
    <div class="mb-6 p-6 bg-gray-50 rounded-lg border border-gray-100 shadow-sm shadow-black/20">
      <div class="flex items-start justify-between gap-4">
        <h2 class="text-xl font-semibold text-secondary mb-2"><%= @current_entity.title || @current_entity.id %></h2>
        <a href={"/stac/api/v1/collections/#{@current_entity.id}"}
           target="_blank" rel="noopener noreferrer"
           title="View API JSON"
           class="ml-4 flex-shrink-0 text-xs font-mono font-medium text-white hover:text-primary border border-black rounded px-2 py-0.5 bg-secondary transition-transform duration-200 hover:scale-110 shadow-lg shadow-black/20">
          &#123;&nbsp;&#125; JSON
        </a>
      </div>
      <p :if={@current_entity.description} class="text-sm text-gray-700 mb-3 whitespace-pre-wrap"><%= @current_entity.description %></p>

      <%!-- Facts about the items in this collection --%>
      <div class="border-y border-gray-200 py-2 mb-4">
        <.stat_strip stats={@collection_stats} />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
          <%!-- Keywords --%>
          <div :if={is_list(@current_entity.keywords) and @current_entity.keywords != []} class="flex flex-wrap gap-1">
            <span :for={word <- @current_entity.keywords} class="inline-block px-2 py-0.5 text-xs rounded-full bg-secondary text-primary"><%= word %></span>
          </div>

          <%!-- Providers --%>
          <div :if={is_list(@current_entity.providers) and @current_entity.providers != []}>
            <h3 class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-1">Providers</h3>
            <ul class="space-y-1 text-sm">
              <li :for={p <- @current_entity.providers} :if={is_map(p)} class="flex flex-wrap items-baseline gap-1.5">
                <span class="font-medium text-gray-900"><%= p["name"] || "n/a" %></span>
                <span :for={r <- (if is_list(p["roles"]), do: p["roles"], else: [])} class="px-1.5 py-0.5 text-xs rounded bg-gray-100 text-gray-600"><%= r %></span>
                <a :if={url?(p["url"])} href={p["url"]} target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:underline break-all"><%= p["url"] %></a>
                <span :if={is_binary(p["description"])} class="text-xs text-gray-500"><%= p["description"] %></span>
              </li>
            </ul>
          </div>

          <%!-- Summaries --%>
          <div :if={is_map(@current_entity.summaries) and map_size(@current_entity.summaries) > 0}>
            <h3 class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-1">Summaries</h3>
            <.kv_grid>
              <.kv :for={{k, v} <- Enum.sort_by(@current_entity.summaries, &elem(&1, 0))} label={humanize_key(k)} raw_key={to_string(k)} value={v} />
            </.kv_grid>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-1">License</h3>
            <%= cond do %>
              <% url = license_url(@current_entity.license) -> %>
                <a href={url} target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline"><%= @current_entity.license %></a>
              <% is_binary(@current_entity.license) -> %>
                <span class="text-sm text-gray-900"><%= @current_entity.license %></span>
              <% true -> %>
                <span class="text-sm text-gray-400 italic">n/a</span>
            <% end %>
          </div>
          <div>
            <h3 class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-1">Temporal extent</h3>
            <.temporal_badge range={temporal_extent(@current_entity.extent)} />
          </div>
          <div :if={spatial_bbox(@current_entity.extent)}>
            <h3 class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-1">Spatial extent (WGS 84)</h3>
            <.bbox_table bbox={spatial_bbox(@current_entity.extent)} />
          </div>
        </div>
      </div>

      <div class="mt-4 flex space-x-4 text-xs text-gray-500 border-t border-gray-200 pt-2">
        <%= if @current_entity.inserted_at do %>
          <span>Created: <%= Calendar.strftime(@current_entity.inserted_at, "%Y-%m-%d %H:%M:%S") %> UTC</span>
        <% end %>
        <%= if @current_entity.updated_at do %>
          <span>Updated: <%= Calendar.strftime(@current_entity.updated_at, "%Y-%m-%d %H:%M:%S") %> UTC</span>
        <% end %>
      </div>

      <%!-- Map visualization for collection spatial extent --%>
      <%= if @current_entity.extent do %>
        <div class="mt-4">
          <h3 class="text-lg font-semibold text-secondary mb-3">Spatial Extent</h3>
          <.stac_map map_id="collection-extent-map" geojson_data={@current_entity.extent} />
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden shadow-lg shadow-black/20">
    <div class="bg-gray-50 px-6 py-3 border-b border-gray-200">
      <div class="grid grid-cols-12 gap-4 text-sm font-medium text-gray-700">
        <div class="col-span-6">Name</div>
        <div class="col-span-2">Type</div>
        <div class="col-span-4">Details</div>
      </div>
    </div>

    <div class="divide-y divide-gray-200">
      <%= for item <- @items do %>
        <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
          <div class="grid grid-cols-12 gap-4 items-center">
            <div class="col-span-6 flex items-center space-x-3">
              <%= if item.is_directory do %>
                <div class="pr-3">
                  📁
                </div>
              <% else %>
                <%= case item.type do %>
                  <% "Item" -> %> <div>📄</div>
                  <% _ -> %> <div>📄</div>
                <% end %>
              <% end %>
              
              <div class="flex flex-col">
                <%= if item.is_directory do %>
                  <a href={"/stac/web/browse/#{item.path}"} 
                     class="text-blue-600 hover:text-blue-800 hover:underline font-medium">
                    <%= item.title %>
                  </a>
                <% else %>
                  <a href={"/stac/web/browse/#{item.path}"} 
                     class="text-secondary hover:underline">
                    <%= item.title %>
                  </a>
                <% end %>
                <%= if item.description do %>
                  <span class="text-xs text-gray-500 mt-1"><%= String.slice(item.description, 0..80) %></span>
                <% end %>
              </div>
            </div>
            
            <div class="col-span-2">
              <span class={[
                "inline-flex px-2 py-1 text-xs font-medium rounded-full",
                type_badge_class(item.type)
              ]}>
                <%= item.type %>
              </span>
            </div>

            <div class="col-span-4 text-sm text-gray-500">
              <%= if Map.has_key?(item, :item_count) do %>
                <%= item.item_count %> items
              <% else %>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <.temporal_badge range={temporal_range(item)} />
                  <span :if={Map.has_key?(item, :asset_count)} class="text-xs text-gray-500 whitespace-nowrap">
                    <%= item.asset_count %> <%= if item.asset_count == 1, do: "asset", else: "assets" %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <%= if Enum.empty?(@items) do %>
        <div class="px-6 py-8 text-center text-gray-500">
          <%= case @current_type do %>
            <% :catalog -> %>
              <p>This catalog contains no collections or sub-catalogs</p>
            <% :collection -> %>
              <p>This collection contains no items</p>
            <% _ -> %>
              <p>No catalogs or collections found</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 text-sm text-gray-500 text-center">
    <p>
      <%= length(@items) %> <%= if @current_type == :collection, do: "items", else: "entries" %>
      <%= if @collection_path do %>
        • Collection: <strong class="text-secondary"><%= @collection_path %></strong>
      <% end %>
    </p>
  </div>
</div>
