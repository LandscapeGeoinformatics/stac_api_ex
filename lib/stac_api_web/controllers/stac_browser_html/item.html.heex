<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <div class="flex items-center justify-between">

      <h1 class="text-2xl font-bold text-gray-900">
        STAC Item Details
      </h1>

      <div class="flex items-center space-x-2">

        <a
          href="/stac/web/search"
          class="btn btn-md bg-secondary hover:bg-secondary text-white hover:text-primary transition-transform duration-200 hover:scale-105 shadow-md shadow-black/50 border-black hover:border-black text-md font-bold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          Search Items
        </a>

        <.auth_controls
          browse_authenticated={@browse_authenticated}
          current_path={"/stac/web/browse/#{@current_path}"}
        />

      </div>
    </div>
  </div>

  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm">
      <%= for {breadcrumb, index} <- Enum.with_index(@breadcrumbs) do %>
        <%= if index > 0 do %>
          <li class="text-gray-400">/</li>
        <% end %>
        <li>
          <%= if index == length(@breadcrumbs) - 1 do %>
            <span class="text-gray-600 font-medium"><%= breadcrumb.name %></span>
          <% else %>
            <a href={"/stac/web/browse/#{breadcrumb.path}"}
               class="text-blue-600 hover:text-blue-800 hover:underline">
              <%= breadcrumb.name %>
            </a>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <%!-- Title bar: title, kind, temporal coverage --%>
  <div class="mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-2xl font-semibold text-secondary break-all">
        <%= (is_binary(@props["title"]) && @props["title"]) || @item.id %>
      </h2>
      <.kind_badge kind={@item_kind} assets={@item.assets} />
      <.temporal_badge range={@temporal} />
    </div>
    <p :if={is_binary(@props["description"])} class="mt-2 text-sm text-gray-700 whitespace-pre-wrap">
      <%= @props["description"] %>
    </p>
  </div>

  <%!-- Row A: overview + footprint map --%>
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 mb-4">
    <.section
      title="Overview"
      class="lg:col-span-2"
      json_href={"/stac/api/v1/collections/#{@item.collection}/items/#{@item.id}"}
    >
      <.kv_grid>
        <.kv label="ID" value={@item.id} mono span />
        <.kv label="Collection">
          <a href={"/stac/web/browse/collection/#{@item.collection}"} class="text-blue-600 hover:underline break-all">
            <%= @item.collection %>
          </a>
        </.kv>
        <.kv label="STAC version" value={@item.stac_version} mono />
        <.kv label="Bbox (WGS 84)" raw_key="bbox" span>
          <.bbox_table bbox={@item.bbox} />
        </.kv>
        <.kv :if={is_list(@item.stac_extensions) and @item.stac_extensions != []} label="Extensions" raw_key="stac_extensions" span>
          <div class="flex flex-wrap gap-1">
            <.extension_chip :for={ext <- @item.stac_extensions} url={to_string(ext)} />
          </div>
        </.kv>
      </.kv_grid>

      <div class="border-t border-gray-100 pt-3 mt-4 grid grid-cols-2 gap-4">
        <%= if @current_entity.inserted_at do %>
          <div>
            <dt class="text-xs font-medium text-gray-400">Record created</dt>
            <dd class="mt-0.5 text-xs text-gray-500 font-mono"><%= Calendar.strftime(@current_entity.inserted_at, "%Y-%m-%d %H:%M:%S") %> UTC</dd>
          </div>
        <% end %>
        <%= if @current_entity.updated_at do %>
          <div>
            <dt class="text-xs font-medium text-gray-400">Record updated</dt>
            <dd class="mt-0.5 text-xs text-gray-500 font-mono"><%= Calendar.strftime(@current_entity.updated_at, "%Y-%m-%d %H:%M:%S") %> UTC</dd>
          </div>
        <% end %>
      </div>
    </.section>

    <.section :if={@item.geometry} title="Footprint / Geometry" class="lg:col-span-3">
      <.stac_map map_id="item-geometry-map" geometry={@item.geometry} properties={@item.properties || %{}} />
    </.section>
  </div>

  <%!-- Row B: projection and table schema (each renders nothing when absent) --%>
  <div :if={@proj_present or @table_present} class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <.projection_card props={@props} />
    <.table_schema_card props={@props} />
  </div>

  <%!-- Row C: assets --%>
  <.section title="Assets" count={if is_map(@item.assets), do: map_size(@item.assets), else: 0} class="mb-4">
    <%= if @primary_assets == [] and @aux_assets == [] do %>
      <p class="text-sm text-gray-500 italic">No assets available</p>
    <% else %>
      <.asset_group
        title={if @aux_assets != [], do: "Data", else: nil}
        assets={@primary_assets}
        columns={asset_columns(@primary_assets)}
      />
      <.asset_group
        title={auxiliary_group_label(@aux_assets)}
        assets={@aux_assets}
        columns={asset_columns(@aux_assets)}
      />
    <% end %>
  </.section>

  <%!-- Row D: remaining properties, grouped by extension --%>
  <.section :if={@property_groups != []} title="Properties" class="mb-4">
    <div class="space-y-5">
      <div :for={{group, entries} <- @property_groups}>
        <h3 class="text-sm font-semibold text-secondary uppercase tracking-wide mb-2 border-b border-gray-200 pb-1">
          <%= group %>
        </h3>
        <.kv_grid>
          <.kv :for={{k, v} <- entries} label={humanize_key(k)} raw_key={k} value={v} span={not scalar?(v)} />
        </.kv_grid>
      </div>
    </div>
  </.section>

  <%!-- Raw JSON, collapsed --%>
  <.section title="Raw JSON">
    <.json_details id="item-json" data={@item} summary="Show item JSON" />
  </.section>
</div>
